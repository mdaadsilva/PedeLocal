# Copy to tests/performance/.env for local overrides. Never commit the real .env.
#
# k6 does not read .env files natively — export these before running k6, e.g.:
#   bash:       set -a; source tests/performance/.env; set +a
#   PowerShell: Get-Content tests/performance/.env | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($Matches[1], $Matches[2]) } }
# See docs/PERFORMANCE_TESTING.md for full instructions.

PEDELOCAL_API_URL=http://localhost:8080

# SUPER_ADMIN used by lib/setup.js to bootstrap isolated cities/establishments/products for each
# scenario's setup() — from DevelopmentDataSeeder (Development only). Override in staging.
PEDELOCAL_ADMIN_EMAIL=admin@pedelocal.dev
PEDELOCAL_ADMIN_PASSWORD=Senha123!

# Optional: reuse a pre-existing CUSTOMER account instead of self-registering fresh ones on every
# run (useful in staging to avoid piling up test users). Leave both empty to self-register.
PEDELOCAL_CUSTOMER_EMAIL=
PEDELOCAL_CUSTOMER_PASSWORD=

# Optional: reserved for a future scenario that needs a pre-existing DRIVER account. Scenario 05
# (first-accept-wins) always registers its own driver pool — it needs several drivers with a
# controlled approval/online state, not a single shared one.
PEDELOCAL_DRIVER_EMAIL=
PEDELOCAL_DRIVER_PASSWORD=

# Password used for every account this suite registers itself (shop admins, self-registered
# customer, driver pools).
PEDELOCAL_TEST_PASSWORD=Senha123!

# smoke | load | stress — see docs/PERFORMANCE_TESTING.md#perfis-de-carga.
PROFILE=smoke

# stress profile only — never hardcode thousands of VUs, keep this modest and raise deliberately.
STRESS_MAX_VUS=80
STRESS_STEPS=4
STRESS_RACE_VUS=5
STRESS_RACE_ITERATIONS=30

# Before running LOAD/STRESS against scenario 01 (login) or any scenario that logs in more than a
# handful of times, raise the API's own auth rate limit for THAT test environment — never weaken
# the production default. Same convention already used by tests/e2e (docs/E2E_TESTING.md):
#   RateLimiting__AuthPermitLimit=1000
#   RateLimiting__GlobalPermitLimit=10000
# Set as environment variables on the API process being tested, not here.

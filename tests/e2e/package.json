{
  "name": "pedelocal-e2e",
  "private": true,
  "version": "0.1.0",
  "description": "Playwright E2E suite for PedeLocal critical flows",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:merchant": "playwright test --project=merchant",
    "test:admin": "playwright test --project=admin",
    "test:realtime": "playwright test --project=realtime",
    "report": "playwright show-report playwright-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^20.19.0",
    "dotenv": "^16.6.1",
    "typescript": "^5.9.2"
  }
}

# Copy to tests/e2e/.env for local overrides. Never commit the real .env.

PEDELOCAL_API_URL=http://localhost:8080
PEDELOCAL_MERCHANT_URL=http://localhost:3000
PEDELOCAL_ADMIN_URL=http://localhost:3001

# SUPER_ADMIN from DevelopmentDataSeeder (Development only). Override in CI/staging.
PEDELOCAL_ADMIN_EMAIL=admin@pedelocal.dev
PEDELOCAL_ADMIN_PASSWORD=Senha123!

# Password used for customers/drivers/merchant admins created during tests.
PEDELOCAL_TEST_PASSWORD=Senha123!

# Set to true only when the API lists merchant/admin origins in Cors:AllowedOrigins.
PEDELOCAL_E2E_REALTIME=false

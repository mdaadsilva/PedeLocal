# Copy to .env and fill in real values. Never commit the real .env file.

POSTGRES_DB=pedelocal
POSTGRES_USER=pedelocal
POSTGRES_PASSWORD=change-me

# Full Npgsql connection string used by the API container.
CONNECTIONSTRINGS__DEFAULT=Host=postgres;Port=5432;Database=pedelocal;Username=pedelocal;Password=change-me

# Must be at least 32 random bytes (base64 or plain string) in every real environment.
JWT__SECRET=change-me-to-a-long-random-secret
JWT__ISSUER=PedeLocal
JWT__AUDIENCE=PedeLocal.Client

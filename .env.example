# Copy to .env and fill in real values. Never commit the real .env file.

POSTGRES_DB=pedelocal
POSTGRES_USER=pedelocal
POSTGRES_PASSWORD=change-me

# Full Npgsql connection string used by the API container.
CONNECTIONSTRINGS__DEFAULT=Host=postgres;Port=5432;Database=pedelocal;Username=pedelocal;Password=change-me

# Must be at least 32 random bytes (base64 or plain string) in every real environment.
JWT__SECRET=change-me-to-a-long-random-secret
JWT__ISSUER=PedeLocal
JWT__AUDIENCE=PedeLocal.Client

# Push notifications (Firebase Cloud Messaging) — optional. Leave FIREBASE__ENABLED unset/false to
# run with the no-op push sender (logs only, no real push — the default, and safe for every
# environment without a Firebase project). See docs/PUSH_NOTIFICATIONS.md for how to get a real
# service-account JSON and paste it as a single line into FIREBASE__CREDENTIALSJSON below.
# NEVER commit a real value here — this file only documents the variable name.
FIREBASE__ENABLED=false
FIREBASE__CREDENTIALSJSON=

# Browser SignalR from merchant-web (:3000) and admin-web (:3001).
# Required for hub negotiate; leave unset in production. Production CORS stays empty.
CORS__ALLOWEDORIGINS__0=http://localhost:3000
CORS__ALLOWEDORIGINS__1=http://localhost:3001
